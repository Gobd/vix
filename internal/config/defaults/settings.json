{
  "agent": "general",
  "features": {
    "read_agents_md": true,
    "read_claude_md": true,
    "show_thinking": false,
    "telemetry": true,
    "tool_orchestrator": false
  },
  "elevenlabs": {
    "agent_id": "agent_7501kqrztj1te17ssqz5wqpnvkf3",
    "auth_mode": "public"
  },
  "logs": {
    "retention_days": 10
  },
  "version": 1,
  "languages": [
    {
      "name": "go",
      "extensions": [".go"],
      "lsp": { "command": "gopls", "args": [] }
    },
    {
      "name": "python",
      "extensions": [".py"],
      "lsp": { "command": "pyright-langserver", "args": ["--stdio"] }
    },
    {
      "name": "typescript",
      "extensions": [".ts", ".tsx", ".js", ".jsx"],
      "lsp": { "command": "typescript-language-server", "args": ["--stdio"] }
    }
  ]
}
